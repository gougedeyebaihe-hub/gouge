#!name = Lynk & Co Auto Sign
#!desc = 每日自动签到 + 文章分享（纯定时式，捕获一次 token 后无需再打开 App）| v20260830-refactor17
#!author = LynkCo Refactor
#!homepage = https://github.com/gougedeyebaihe-hub/gouge
#!date = 2026-08-30
#!system = iOS,iPadOS,tvOS,macOS
#!loon_version = 3.2.1(733)
#!tag = 签到,领克
#!type = normal

[Argument]
refreshToken = input,"",tag=手动 refreshToken,desc=留空时由流量捕获自动保存
deviceId = input,"",tag=deviceId,desc=留空时自动捕获
deviceType = select,"IOS","Android",tag=设备类型
appVersion = input,"4.2.3",tag=App 版本,desc=领克 App 版本号
articleId = input,"",tag=固定分享文章 ID,desc=留空自动取广场最新文章
xCaKey = input,"203760416",tag=X-Ca-Key,desc=网关密钥，轮换后需更新
appSecret = input,"",tag=AppSecret,desc=留空按 xCaKey 自动匹配
appCode = input,"3fa3314998bd4195a9fe2df3e85e6a12",tag=AppCode,desc=静态认证用
shareEnabled = switch,true,tag=启用文章分享
autoRunOnCapture = switch,false,tag=捕获后立即运行
oncePerDay = switch,true,tag=每日仅一次,desc=当日成功后静默跳过
debug = switch,true,tag=诊断信息,desc=通知附带签名/响应摘要
captureNotify = switch,false,tag=捕获通知,desc=捕获 token 时发通知；重抓时临时开
cronTime = select,"10 0 * * *","1 0 * * *","30 0 * * *","30 1 * * *","30 7 * * *","30 12 * * *",tag=每日签到时刻,desc=依次为 00:10/00:01/00:30/01:30/07:30/12:30；无效表达式该行不执行
retryCron = select,"10 3 * * *","1 3 * * *","30 3 * * *","30 4 * * *","30 10 * * *","30 15 * * *",tag=失败重试时刻,desc=依次为 03:10/03:01/03:30/04:30/10:30/15:30；建议比签到时刻晚约3小时

[Script]
cron {cronTime} script-path=https://raw.githubusercontent.com/gougedeyebaihe-hub/gouge/main/lynkco.bundle.js?v=v20260830-refactor17,tag=lynkco-daily-0001,timeout=120,argument=[{refreshToken},{deviceId},{deviceType},{appVersion},{articleId},{xCaKey},{appSecret},{appCode},{shareEnabled},{autoRunOnCapture},{oncePerDay},{debug},{captureNotify},{cronTime},{retryCron}],enable=true
cron {retryCron} script-path=https://raw.githubusercontent.com/gougedeyebaihe-hub/gouge/main/lynkco.bundle.js?v=v20260830-refactor17,tag=lynkco-daily-0301,timeout=120,argument=[{refreshToken},{deviceId},{deviceType},{appVersion},{articleId},{xCaKey},{appSecret},{appCode},{shareEnabled},{autoRunOnCapture},{oncePerDay},{debug},{captureNotify},{cronTime},{retryCron}],enable=true
http-request ^https?:\/\/(h5-api|h5|app-api-gw-toc|app-services|gric-api)\.(lynkco\.com|lynkco\.com\.cn|geely\.com)\/.* script-path=https://raw.githubusercontent.com/gougedeyebaihe-hub/gouge/main/lynkco.bundle.js?v=v20260830-refactor17,requires-body=true,tag=lynkco-capture-request,timeout=30,argument=[{refreshToken},{deviceId},{deviceType},{appVersion},{articleId},{xCaKey},{appSecret},{appCode},{shareEnabled},{autoRunOnCapture},{oncePerDay},{debug},{captureNotify},{cronTime},{retryCron}],enable=true
http-response ^https?:\/\/(h5-api|h5|app-api-gw-toc|app-services|gric-api)\.(lynkco\.com|lynkco\.com\.cn|geely\.com)\/.* script-path=https://raw.githubusercontent.com/gougedeyebaihe-hub/gouge/main/lynkco.bundle.js?v=v20260830-refactor17,requires-body=true,tag=lynkco-capture-response,timeout=30,argument=[{refreshToken},{deviceId},{deviceType},{appVersion},{articleId},{xCaKey},{appSecret},{appCode},{shareEnabled},{autoRunOnCapture},{oncePerDay},{debug},{captureNotify},{cronTime},{retryCron}],enable=true
generic script-path=https://raw.githubusercontent.com/gougedeyebaihe-hub/gouge/main/lynkco.bundle.js?v=v20260830-refactor17,tag=lynkco-manual,timeout=120,argument=[{refreshToken},{deviceId},{deviceType},{appVersion},{articleId},{xCaKey},{appSecret},{appCode},{shareEnabled},{autoRunOnCapture},{oncePerDay},{debug},{captureNotify},{cronTime},{retryCron}],enable=true

[MITM]
hostname = h5-api.lynkco.com,h5.lynkco.com,app-api-gw-toc.lynkco.com,app-services.lynkco.com.cn,gric-api.geely.com
