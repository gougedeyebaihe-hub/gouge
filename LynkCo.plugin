#!name=Lynk & Co Auto Sign
#!desc=每日自动签到 + 文章分享（纯定时式，捕获一次 token 后无需再打开 App）| v20260813-refactor2
#!arguments=refreshToken=,deviceId=,deviceType=IOS,appVersion=4.2.3,articleId=,xCaKey=203760416,appSecret=,appCode=3fa3314998bd4195a9fe2df3e85e6a12,shareEnabled=1,autoRunOnCapture=0,oncePerDay=1,debug=1
