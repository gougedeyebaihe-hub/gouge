#!name=Lynk & Co Auto Tasks
#!desc=Capture auth state and run sign when a Lynk & Co token is detected | Version v20260812r
#!arguments=articleId=,debugNotify=0,shareEnabled=0,autoRunOnCapture=1,pingNotify=1,captureTraceNotify=0,signTraceNotify=0,signRequestNotify=1,signCandidateNotify=0,signUpgradeNotify=0
#!author=OpenAI Codex
#!homepage=https://nsloon.app/docs/

[Argument]
articleId=
debugNotify=0
shareEnabled=0
autoRunOnCapture=1
pingNotify=1
captureTraceNotify=0
signTraceNotify=0
signRequestNotify=1
signCandidateNotify=0
signUpgradeNotify=0

[Script]
cron "*/30 * * * *" script-path=https://raw.githubusercontent.com/gougedeyebaihe-hub/gouge/main/auto.bundle.js?v=20260812r,tag=lynkco-auto-cron,timeout=90,enable=true
http-request ^https?:\/\/(h5-api|h5|app-api-gw-toc|app-services)\.lynkco(\.com|\.com\.cn)\/.* script-path=https://raw.githubusercontent.com/gougedeyebaihe-hub/gouge/main/auto.bundle.js?v=20260812r,requires-body=true,tag=lynkco-auto-capture,timeout=90,enable=true
http-response ^https?:\/\/(h5-api|h5|app-api-gw-toc|app-services)\.lynkco(\.com|\.com\.cn)\/.* script-path=https://raw.githubusercontent.com/gougedeyebaihe-hub/gouge/main/auto.bundle.js?v=20260812r,requires-body=true,tag=lynkco-auto-run,timeout=90,enable=true

[MITM]
hostname = h5-api.lynkco.com,h5.lynkco.com,app-api-gw-toc.lynkco.com,app-services.lynkco.com.cn
