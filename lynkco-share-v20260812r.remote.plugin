#!name=Lynk & Co Auto Tasks
#!desc=Capture auth state and run sign/share when a Lynk & Co token is detected | Version v20260812w
#!arguments=articleId=,debugNotify=0,shareEnabled=1,autoRunOnCapture=1,oncePerDay=0,pingNotify=0,captureTraceNotify=0,signTraceNotify=0,signRequestNotify=0,signCandidateNotify=0,signUpgradeNotify=0
