[Argument]
articleId=
debugNotify=0
shareEnabled=1
autoRunOnCapture=1
oncePerDay=0
pingNotify=0
captureTraceNotify=0
signTraceNotify=0
signRequestNotify=0
signCandidateNotify=0
signUpgradeNotify=0

[Script]
cron "*/30 * * * *" script-path=https://raw.githubusercontent.com/gougedeyebaihe-hub/gouge/main/auto.bundle.js?v=20260812w&oncePerDay=0&pingNotify=0&signRequestNotify=0&shareEnabled=1,tag=lynkco-auto-cron,timeout=90,enable=true
http-request ^https?:\/\/(h5-api|h5|app-api-gw-toc|app-services)\.lynkco(\.com|\.com\.cn)\/.* script-path=https://raw.githubusercontent.com/gougedeyebaihe-hub/gouge/main/auto.bundle.js?v=20260812w&oncePerDay=0&pingNotify=0&signRequestNotify=0&shareEnabled=1,requires-body=true,tag=lynkco-auto-capture,timeout=90,enable=true
http-response ^https?:\/\/(h5-api|h5|app-api-gw-toc|app-services)\.lynkco(\.com|\.com\.cn)\/.* script-path=https://raw.githubusercontent.com/gougedeyebaihe-hub/gouge/main/auto.bundle.js?v=20260812w&oncePerDay=0&pingNotify=0&signRequestNotify=0&shareEnabled=1,requires-body=true,tag=lynkco-auto-run,timeout=90,enable=true

[MITM]
hostname = h5-api.lynkco.com,h5.lynkco.com,app-api-gw-toc.lynkco.com,app-services.lynkco.com.cn
